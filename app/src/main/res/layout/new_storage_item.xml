<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="3dp">

    <com.android.imagic.files.ui.CheckableForegroundLinearLayout
        android:id="@+id/itemLayout"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingVertical="5dp">

        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/storage_list_title"
            android:scaleType="centerCrop"
            tools:srcCompat="@drawable/nav_storage_internal" />

        <Space
            android:layout_width="3dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:lineHeight="19dp"
                android:singleLine="true"
                android:textColor="#FF262626"
                android:textSize="13sp"
                tools:ignore="UnusedAttribute"
                tools:text="内部存储空间" />

            <com.android.imagic.files.ui.AutoGoneTextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:lineHeight="13dp"
                android:singleLine="true"
                android:textColor="#80262626"
                android:textSize="9sp"
                tools:ignore="SmallSp,UnusedAttribute"
                tools:text="66 Gb / 128 Gb" />
        </LinearLayout>

        <ImageView
            android:id="@+id/storageActionImage"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_margin="5dp"
            android:contentDescription="@string/storage_list_title"
            android:scaleType="centerCrop"
            android:src="@drawable/nav_storage_item_action" />
    </com.android.imagic.files.ui.CheckableForegroundLinearLayout>
</LinearLayout>