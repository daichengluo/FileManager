<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/background"
    android:layout_width="247dp"
    android:layout_height="83dp"
    android:background="@drawable/bg_widget_launcher_login"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/loginSuccessLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/userHeaderImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="11dp"
            android:background="@drawable/bg_widget_user_header_image"
            android:clipToOutline="true"
            android:contentDescription="user header image"
            android:scaleType="centerCrop"
            android:src="@drawable/nav_user_header_img"
            tools:ignore="UnusedAttribute" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/usernameText"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:lineHeight="19dp"
                android:textColor="#FF2C2C2E"
                android:textSize="13sp"
                tools:ignore="UnusedAttribute" />

            <ProgressBar
                android:id="@+id/progressbar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="107dp"
                android:layout_height="3dp"
                android:layout_marginTop="11dp"
                android:progressDrawable="@drawable/widget_storage_space_progress" />

            <TextView
                android:id="@+id/storageSpaceText"
                android:layout_width="wrap_content"
                android:layout_height="9dp"
                android:layout_marginTop="4dp"
                android:lineHeight="9dp"
                android:textColor="#FF757575"
                android:textSize="7sp"
                tools:ignore="SmallSp,UnusedAttribute" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="11dp"
            android:background="#1A000000"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="53dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/gotToDriveButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:foreground="@drawable/fg_widget_launcher_login_action_button"
                android:src="@drawable/go_to_drive" />

            <ImageButton
                android:id="@+id/logoutButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="1dp"
                android:background="@null"
                android:foreground="@drawable/fg_widget_launcher_login_action_button"
                android:src="@drawable/widget_logout" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/needLoginLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/widgetLoginButton"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_widget_launcher_login_button"
                android:fontFamily="sans-serif-medium"
                android:foreground="@drawable/fg_widget_launcher_login_button"
                android:gravity="center"
                android:lineHeight="19dp"
                android:minWidth="68dp"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="@string/widget_launcher_login_button_text"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/loginTipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:layout_marginTop="8dp"
                android:lineHeight="17dp"
                android:text="@string/widget_launcher_login_tip_text"
                android:textColor="#FF999999"
                android:textSize="12sp"
                tools:ignore="UnusedAttribute" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/loginActonButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="16dp"
            android:background="@null"
            android:contentDescription="@string/widget_launcher_login_button_text"
            android:foreground="@drawable/fg_widget_launcher_login_action_button"
            android:src="@drawable/widget_launcher_login_action" />
    </LinearLayout>
</FrameLayout>