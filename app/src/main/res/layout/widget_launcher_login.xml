<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/background"
    android:layout_width="247dp"
    android:layout_height="107dp"
    android:background="@drawable/bg_widget_launcher_login"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/loginSuccessLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/userHeaderImage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_widget_user_header_image"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/nav_user_header_img"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/usernameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineHeight="19dp"
                android:paddingHorizontal="11dp"
                android:textColor="#FF2C2C2E"
                android:textSize="13sp"
                tools:ignore="UnusedAttribute"
                tools:text="Jonathan Thomas" />

            <LinearLayout
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:background="#1A000000"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/gotToDriveButton"
                    android:layout_width="18.5dp"
                    android:layout_height="18.5dp"
                    android:background="@null"
                    android:contentDescription="@null"
                    android:foreground="@drawable/fg_widget_launcher_login_action_button"
                    android:src="@drawable/go_to_drive" />

                <ImageButton
                    android:id="@+id/logoutButton"
                    android:layout_width="18.5dp"
                    android:layout_height="18.5dp"
                    android:background="@null"
                    android:contentDescription="@null"
                    android:foreground="@drawable/fg_widget_launcher_login_action_button"
                    android:src="@drawable/widget_logout" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingVertical="5dp"
            android:paddingStart="22dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/thirdDriveLayout"
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:layout_marginBottom="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/fg_widget_launcher_login_action_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/thirdDriveIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_widget_user_header_image"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/nav_list_google_icon"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/thirdDriveName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineHeight="11dp"
                    android:paddingHorizontal="11dp"
                    android:textColor="#FF262626"
                    android:textSize="8sp"
                    tools:ignore="SmallSp,UnusedAttribute"
                    tools:text="Google Drive" />

                <ProgressBar
                    android:id="@+id/thirdDriveProgressbar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="37dp"
                    android:layout_height="3dp"
                    android:progressDrawable="@drawable/widget_storage_space_progress" />

                <TextView
                    android:id="@+id/thirdDriveSpaceText"
                    android:layout_width="75dp"
                    android:layout_height="9dp"
                    android:gravity="end"
                    android:lineHeight="9dp"
                    android:paddingHorizontal="5dp"
                    android:textColor="#80262626"
                    android:textSize="7sp"
                    tools:ignore="SmallSp,UnusedAttribute"
                    tools:text="110GB / 128 GB" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/starBoardDriveLayout"
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/fg_widget_launcher_login_action_button"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/starBoardDriveIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_widget_user_header_image"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/starboard_drive_icon"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/starBoardDriveNameText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineHeight="11dp"
                    android:paddingHorizontal="11dp"
                    android:text="@string/starboard_drive"
                    android:textColor="#FF262626"
                    android:textSize="8sp"
                    tools:ignore="SmallSp,UnusedAttribute" />

                <ProgressBar
                    android:id="@+id/starBoardDriveProgressbar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="37dp"
                    android:layout_height="3dp"
                    android:progressDrawable="@drawable/widget_storage_space_progress" />

                <TextView
                    android:id="@+id/starBoardDriveSpaceText"
                    android:layout_width="75dp"
                    android:layout_height="9dp"
                    android:gravity="end"
                    android:lineHeight="9dp"
                    android:paddingHorizontal="5dp"
                    android:textColor="#80262626"
                    android:textSize="7sp"
                    tools:ignore="SmallSp,UnusedAttribute"
                    tools:text="56GB / 128 GB" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/needLoginLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/widgetLoginButton"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_widget_launcher_login_button"
                android:foreground="@drawable/fg_widget_launcher_login_button"
                android:gravity="center"
                android:lineHeight="17dp"
                android:minWidth="77dp"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:text="@string/widget_launcher_login_button_text"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/loginTipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="11dp"
                android:lineHeight="15dp"
                android:text="@string/widget_launcher_login_tip_text"
                android:textColor="#FF999999"
                android:textSize="11sp"
                tools:ignore="UnusedAttribute" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/qrCodeImage"
                android:layout_width="59dp"
                android:layout_height="59dp"
                android:layout_marginTop="24dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:ignore="UnusedAttribute" />

            <ProgressBar
                android:id="@+id/qrCodeProgressBar"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:indeterminate="true"
                android:indeterminateTint="#999999"
                android:indeterminateTintMode="src_in" />

            <ImageButton
                android:id="@+id/refreshQRCode"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@null"
                android:contentDescription="@null"
                android:foreground="@drawable/fg_widget_launcher_login_action_button"
                android:src="@drawable/icon_refresh_qrcode"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>