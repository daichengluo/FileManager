<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dragPlaceholder"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="100dp"
        android:visibility="invisible">

        <FrameLayout
            android:id="@+id/iconLayout"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/surface_background"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.android.imagic.files.ui.DisabledAlphaImageView
                android:id="@+id/iconImage"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:scaleType="centerCrop" />

            <com.android.imagic.files.ui.DisabledAlphaImageView
                android:id="@+id/thumbnailImage"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedCornerImage" />

            <com.android.imagic.files.ui.DisabledAlphaImageView
                android:id="@+id/appIconBadgeImage"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                app:shapeAppearanceOverlay="@style/RoundedCornerImage" />

            <LinearLayout
                android:id="@+id/fileCountLayout"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_drag_drop_file_count"
                android:clipToOutline="true"
                android:gravity="center"
                android:orientation="vertical"
                tools:ignore="UnusedAttribute">

                <TextView
                    android:id="@+id/fileCountTextView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textAlignment="center"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>