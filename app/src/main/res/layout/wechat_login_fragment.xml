<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <WebView
        android:id="@+id/webview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/qrcodeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <TextView
            android:id="@+id/qrcodeLoginTipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineHeight="13dp"
            android:maxLines="3"
            android:paddingHorizontal="29dp"
            android:text="@string/wechat_scan_login"
            android:textColor="#FF4E4E4E"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp,UnusedAttribute" />

        <ImageView
            android:id="@+id/qrcodeImageView"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:layout_marginTop="60dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:layout_marginTop="110dp"
            android:progressDrawable="@drawable/wechat_login_progress"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <me.zhanghai.android.foregroundcompat.ForegroundLinearLayout
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="190dp"
            android:background="@drawable/bg_wechat_login_button"
            android:foreground="@drawable/fg_widget_launcher_login_button"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineHeight="11dp"
                android:text="@string/back"
                android:textColor="#FF6383FA"
                android:textSize="9sp"
                tools:ignore="SmallSp,UnusedAttribute" />
        </me.zhanghai.android.foregroundcompat.ForegroundLinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scanSuccessLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/scanSuccessImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginTop="48dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/wechat_scan_success_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/scanSuccessTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:maxLines="3"
            android:paddingHorizontal="29dp"
            android:text="@string/scanned_successfully"
            android:textColor="#D9000000"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scanSuccessImage" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:lineHeight="15dp"
            android:maxLines="3"
            android:paddingHorizontal="29dp"
            android:text="@string/wechat_tap_allow_tip"
            android:textColor="#73000000"
            android:textSize="9sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scanSuccessTextView"
            tools:ignore="SmallSp,UnusedAttribute" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/failureLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <TextView
            android:id="@+id/failureTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:gravity="center"
            android:lineHeight="21dp"
            android:paddingHorizontal="24dp"
            android:text="@string/login_has_been_canceled"
            android:textColor="#D9000000"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp,UnusedAttribute" />

        <me.zhanghai.android.foregroundcompat.ForegroundLinearLayout
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/bg_wechat_login_button"
            android:foreground="@drawable/fg_widget_launcher_login_button"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@+id/failureBackButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/failureTextView">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineHeight="11dp"
                android:text="@string/retry"
                android:textColor="#FF6383FA"
                android:textSize="9sp"
                tools:ignore="SmallSp,UnusedAttribute" />
        </me.zhanghai.android.foregroundcompat.ForegroundLinearLayout>

        <me.zhanghai.android.foregroundcompat.ForegroundLinearLayout
            android:id="@+id/failureBackButton"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="64dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_wechat_login_button"
            android:foreground="@drawable/fg_widget_launcher_login_button"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/retryButton"
            app:layout_constraintTop_toBottomOf="@+id/failureTextView">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineHeight="11dp"
                android:text="@string/back"
                android:textColor="#FF6383FA"
                android:textSize="9sp"
                tools:ignore="SmallSp,UnusedAttribute" />
        </me.zhanghai.android.foregroundcompat.ForegroundLinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>