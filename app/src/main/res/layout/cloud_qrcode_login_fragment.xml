<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/qrcodeLoginTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineHeight="15dp"
        android:text="@string/qrcode_login_tip_text"
        android:textColor="#FF4E4E4E"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UnusedAttribute" />

    <ImageView
        android:id="@+id/qrcodeImageView"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:layout_marginTop="35dp"
        android:contentDescription="QrCode Image"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qrcodeLoginTitleText" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="center"
        android:progressDrawable="@drawable/file_transfer_progress"
        app:layout_constraintBottom_toBottomOf="@+id/qrcodeImageView"
        app:layout_constraintEnd_toEndOf="@+id/qrcodeImageView"
        app:layout_constraintStart_toStartOf="@+id/qrcodeImageView"
        app:layout_constraintTop_toTopOf="@+id/qrcodeImageView" />

    <TextView
        android:id="@+id/qrcodeLoginTipText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:gravity="center"
        android:lineHeight="13dp"
        android:maxLines="3"
        android:paddingHorizontal="29dp"
        android:text="@string/qrcode_login_scan_tip"
        android:textColor="#FF757575"
        android:textSize="9sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qrcodeImageView"
        tools:ignore="SmallSp,UnusedAttribute" />

</androidx.constraintlayout.widget.ConstraintLayout>
