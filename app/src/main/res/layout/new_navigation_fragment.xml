<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="270dp"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFEFF0F7"
        android:orientation="vertical"
        android:paddingHorizontal="13dp">

        <TextView
            android:id="@+id/appNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:lineHeight="30dp"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textAlignment="textStart"
            android:textColor="#FF262626"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:ignore="UnusedAttribute" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="11dp" />

        <EditText
            android:id="@+id/searchBarEdit"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@drawable/search_bar_background"
            android:clipToOutline="true"
            android:hint="搜索文件"
            android:inputType="text"
            android:lineHeight="19dp"
            android:paddingHorizontal="16dp"
            android:textColor="#57262626"
            android:textSize="13sp"
            tools:ignore="UnusedAttribute" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="11dp" />

        <com.android.imagic.files.ui.CheckableForegroundLinearLayout
            android:id="@+id/loginLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_background"
            android:foreground="@drawable/nav_login_foreground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/userHeaderImage"
                android:layout_width="53dp"
                android:layout_height="53dp"
                android:layout_margin="11dp"
                android:contentDescription="avatar"
                android:src="@drawable/nav_user_header_img" />

            <TextView
                android:id="@+id/loginTipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:lineHeight="22dp"
                android:singleLine="true"
                android:text="请登录账号"
                android:textAlignment="textStart"
                android:textColor="#FF262626"
                android:textSize="16sp"
                tools:ignore="UnusedAttribute" />

            <ImageView
                android:id="@+id/loginButton"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_margin="11dp"
                android:contentDescription="Login action"
                android:src="@drawable/nav_user_login_action" />
        </com.android.imagic.files.ui.CheckableForegroundLinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="11dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/classShortcutRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="11dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="11dp" />

        <LinearLayout
            android:id="@+id/storageLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_background"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="11dp">

            <TextView
                android:id="@+id/storageTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:lineHeight="19dp"
                android:singleLine="true"
                android:text="存储空间"
                android:textAlignment="textStart"
                android:textColor="#FF262626"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="UnusedAttribute" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/storageRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_background"
                android:paddingVertical="8dp"
                tools:listitem="@layout/new_storage_item" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="11dp" />

            <com.android.imagic.files.ui.CheckableForegroundLinearLayout
                android:id="@+id/addStorageLayout"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:background="@drawable/nav_button_background"
                android:foreground="@drawable/file_item_list_foreground"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/addButtonImage"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="Add storage"
                    android:scaleType="centerCrop"
                    android:src="@drawable/nav_storage_add" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/addStorageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:lineHeight="20dp"
                    android:singleLine="true"
                    android:text="添加存储空间"
                    android:textAlignment="textStart"
                    android:textColor="#FF0559FF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="UnusedAttribute" />
            </com.android.imagic.files.ui.CheckableForegroundLinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>