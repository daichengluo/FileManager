<?xml version="1.0" encoding="utf-8"?>
<com.android.imagic.files.ui.CheckableForegroundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="5dp">

    <ImageView
        android:id="@+id/iconImage"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_marginHorizontal="8dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="5dp" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:lineHeight="13dp"
        android:singleLine="true"
        android:textColor="#FF262626"
        android:textFontWeight="500"
        android:textSize="9sp"
        tools:ignore="SmallSp,UnusedAttribute"
        tools:text="Picture" />
</com.android.imagic.files.ui.CheckableForegroundLinearLayout>