<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <com.android.imagic.files.ui.CheckableForegroundLinearLayout
        android:id="@+id/itemLayout"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Space
            android:layout_width="11dp"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/iconLayout"
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:clipToPadding="false"
            android:duplicateParentState="true">

            <com.android.imagic.files.ui.DisabledAlphaImageView
                android:id="@+id/iconImage"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:scaleType="centerCrop" />

            <com.android.imagic.files.ui.DisabledAlphaImageView
                android:id="@+id/thumbnailImage"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedCornerImage" />

            <com.android.imagic.files.ui.DisabledAlphaImageView
                android:id="@+id/appIconBadgeImage"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="end|bottom"
                android:layout_marginStart="-0.5dp"
                android:layout_marginTop="-0.5dp"
                android:layout_marginEnd="-0.5dp"
                android:layout_marginBottom="-0.5dp"
                android:duplicateParentState="true"
                app:shapeAppearanceOverlay="@style/RoundedCornerImage" />
        </FrameLayout>

        <Space
            android:layout_width="11dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">

            <!-- Lint says android:ellipsize="middle" and android:maxLines="1" crashes. -->
            <TextView
                android:id="@+id/nameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearanceListItem" />

            <com.android.imagic.files.ui.AutoGoneTextView
                android:id="@+id/descriptionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearanceListItemSecondary" />
        </LinearLayout>

        <!--
          ~ Cannot use android:duplicateParentState="true" because a button needs to have its own
          ~ pressed state, etc. Necessary states will be duplicated manually in the adapter
          ~ implementation.
          -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:duplicateParentState="true">

            <me.zhanghai.android.foregroundcompat.ForegroundImageButton
                android:id="@+id/menuButton"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginHorizontal="4dp"
                android:background="@null"
                android:foreground="@drawable/selectable_item_background_oval"
                android:padding="6dp"
                android:src="@drawable/file_item_action_icon" />

            <com.android.imagic.files.ui.DisabledAlphaImageView
                android:id="@+id/checkImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:duplicateParentState="true"
                android:src="@drawable/checkable_badge" />
        </FrameLayout>
    </com.android.imagic.files.ui.CheckableForegroundLinearLayout>
</LinearLayout>