<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/qrcodeLoginTipText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineHeight="15dp"
        android:text="@string/login_in"
        android:textColor="#FF4E4E4E"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UnusedAttribute" />

    <me.zhanghai.android.foregroundcompat.ForegroundLinearLayout
        android:id="@+id/loginWithGoogle"
        android:layout_width="193dp"
        android:layout_height="37dp"
        android:layout_marginTop="27dp"
        android:background="@drawable/bg_google_login"
        android:foreground="@drawable/fg_login_7dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qrcodeLoginTipText">

        <ImageView
            android:id="@+id/googleIcon"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:contentDescription="@string/login_google_account"
            android:src="@drawable/cloud_google_normal" />


        <TextView
            android:id="@+id/googleLoginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="start"
            android:lineHeight="12dp"
            android:text="@string/login_google_account"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp,UnusedAttribute" />
    </me.zhanghai.android.foregroundcompat.ForegroundLinearLayout>

    <me.zhanghai.android.foregroundcompat.ForegroundLinearLayout
        android:id="@+id/loginWithMicrosoft"
        android:layout_width="193dp"
        android:layout_height="37dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_microsoft_login"
        android:foreground="@drawable/fg_login_7dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginWithGoogle">

        <ImageView
            android:id="@+id/microsoftIcon"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:contentDescription="@string/login_microsoft_account"
            android:src="@drawable/cloud_microsoft_normal" />


        <TextView
            android:id="@+id/microsoftLoginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="start"
            android:lineHeight="12dp"
            android:text="@string/login_microsoft_account"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp,UnusedAttribute" />
    </me.zhanghai.android.foregroundcompat.ForegroundLinearLayout>

    <me.zhanghai.android.foregroundcompat.ForegroundLinearLayout
        android:id="@+id/loginWithWechat"
        android:layout_width="193dp"
        android:layout_height="37dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/bg_wechat_login"
        android:foreground="@drawable/fg_login_7dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="5dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginWithMicrosoft">

        <ImageView
            android:id="@+id/wechatIcon"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:contentDescription="@string/login_wechat_account"
            android:src="@drawable/cloud_wechat_normal" />


        <TextView
            android:id="@+id/wechatLoginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="start"
            android:lineHeight="12dp"
            android:text="@string/login_wechat_account"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp,UnusedAttribute" />
    </me.zhanghai.android.foregroundcompat.ForegroundLinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progressBarLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_navigation_login"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineHeight="12dp"
            android:text="@string/loading_user_data"
            android:textColor="#FF757575"
            android:textSize="9sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBar"
            tools:ignore="SmallSp,UnusedAttribute" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
