<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.android.imagic.files.ui.BottomBarLayout
        android:id="@+id/bottomBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_bar_gradient_background"
        android:fitsSystemWindows="true"
        android:theme="?actionBarTheme">

        <ProgressBar
            android:id="@+id/bottomProgressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:visibility="invisible" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/bottomToolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:paddingStart="@dimen/file_list_toolbar_padding_start"
            android:paddingEnd="@dimen/file_list_toolbar_padding_end_no_overflow"
            app:navigationContentDescription="@string/close"
            app:navigationIcon="@drawable/close_icon_control_normal_24dp"
            app:popupTheme="?actionBarPopupTheme"
            app:titleTextAppearance="@style/BottomBarTitleTextAppearance"
            app:titleTextColor="#80262626">

            <EditText
                android:id="@+id/bottomCreateFileNameEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/file_list_create_file_name_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />
        </androidx.appcompat.widget.Toolbar>
    </com.android.imagic.files.ui.BottomBarLayout>
</merge>
